// A branch whose operand comes from the LD right before it: ID stalls a
// cycle with op1 forced to 0.  The branch must wait, not act on that 0.
//   0  LI   R0, #0
5000
//   1  LI   R2, #0
5800
//   2  LI   R3, #1
5C01
//   3  LD   R1, 0(R0)        ; R1 = M[0] = 5
7400
//   4  BEQ  R1, R2, bad      ; 5 != 0 -> not taken
9182
//   5  HALT R2
D800
//   6  bad:    LI   R3, #7
5C07
//   7  HALT R2
D800
