// sumn -- 累加 M[0..31]。就是 doc/ISA.md 的例子放大到 32 个字。
// 每次迭代的 LD 紧接着被用，所以每一圈都吃一个 load-use 气泡；
// 数据存储的延迟也全落在关键路径上。
//   R0 = i   R1 = sum   R2 = 载入值   R3 = 上界
//   0  LI   R0, #0
5000
//   1  LI   R1, #0
5400
//   2  LI   R3, #32
5C20
//   3  loop:   LD   R2, 0(R0)
7800
//   4  ADD  R1, R1, R2      ; load-use：前递救不了，一个气泡
1581
//   5  ADDI R0, R0, #1
2001
//   6  BLT  R0, R3, loop
BCFD
//   7  LI   R0, #0
5000
//   8  ST   R1, -1(R0)      ; M[0xFF] = sum -> LED
8C7F
//   9  HALT R2
D800
