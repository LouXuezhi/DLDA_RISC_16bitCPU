// All four branches, JAL and JALR.  Every slot that must be skipped writes
// a distinct poison into R1, and nothing afterwards rewrites R1 -- so a
// branch that resolves the wrong way survives to the final check.
//     0  LI   R0, #5
5005
//     1  LI   R1, #5
5405
//     2  BEQ  R0, R1, +2      ; equal -> taken, to 4
9042
//     3  LI   R1, #0x11       ; poison: BEQ failed to take
5411
//     4  BGE  R0, R1, +2      ; equal -> taken.  >= , not >
C042
//     5  LI   R1, #0x22       ; poison: BGE compared with > instead of >=
5422
//     6  BNE  R0, R1, +2      ; equal -> NOT taken.  If taken, lands on 8
A042
//     7  JAL  R2, +3          ; -> 10, over both poisons
D803
//     8  LI   R1, #0x33       ; poison: BNE taken when it should not be
5433
//     9  LI   R1, #0x44       ; poison: JAL landed short
5444
//    10  LI   R2, #13         ; JALR target
580D
//    11  JALR R3, 0(R2)       ; -> 13, link = 12
EE00
//    12  LI   R1, #0x55       ; poison: JALR target came from the PC
5455
//    13  BLT  R0, R1, +2      ; 5 < 5 false -> NOT taken.  If taken, to 15
B042
//    14  JAL  R2, +2          ; -> 16, over the poison
D802
//    15  LI   R1, #0x66       ; poison: BLT taken when it should not be
5466
//    16  JAL  R2, #0          ; halt
D800
