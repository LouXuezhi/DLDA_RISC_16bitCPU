// doc/ISA.md's worked example: sum M[0..3], show the total on the LEDs, stop.
//        LI   R0, #0          ; i = 0
5000
//        LI   R1, #0          ; sum = 0
5400
//        LI   R3, #4          ; limit
5C04
// loop:  LD   R2, 0(R0)       ; v = M[i]
7800
//        ADD  R1, R1, R2      ; sum += v      (load-use: one bubble)
1581
//        ADDI R0, R0, #1      ; i++
2001
//        BLT  R0, R3, loop    ; while (i < 4)   -3
BCFD
//        LI   R0, #0
5000
//        ST   R1, -1(R0)      ; M[0xFF] = sum -> LEDs (address truncates)
8C7F
// done:  JAL  R3, #0          ; halt: jump to self, relative
DC00
