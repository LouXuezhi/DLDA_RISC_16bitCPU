// SRA vs SRL on a negative value -- the one place the two differ.
//        LI  R0, #-8          ; R0 = FFF8
50F8
//        LI  R1, #2
5402
//        SRA R2, R0, R1       ; R2 = FFFE   sign-filled
184B
//        SRL R3, R0, R1       ; R3 = 3FFE   zero-filled
1C4A
//        JAL R1, #0           ; halt
D400
